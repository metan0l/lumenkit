{
  "name": "lumenkit",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:generate": "pnpm --filter @lumenkit/db db:generate",
    "db:migrate": "pnpm --filter @lumenkit/db db:migrate",
    "db:seed": "pnpm --filter @lumenkit/db db:seed",
    "db:studio": "pnpm --filter @lumenkit/db db:studio"
  },
  "packageManager": "pnpm@12.6.0",
  "devDependencies": {
    "turbo": "^2.11.8",
    "typescript": "^5.9.3"
  }
}
