# Скопируйте в .env и заполните ключи. Значения ниже совпадают с docker-compose.yml.
DATABASE_URL=postgres://lumenkit:lumenkit@localhost:5433/lumenkit
REDIS_URL=redis://localhost:6380

S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
